{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flor de Lotus",
  "version": "0.1.12",
  "identifier": "com.flordelotus.agenda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flor de Lotus — Agenda do salão",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczODQ5MTQ4RkU5ODQzRUIKUldUclE1aitTSkdFYzJ3OXhmZWRIUGN2QXJGczlGSUdndHZDZXpiL0p3RXFBVHFvZENueEw3ejEK",
      "endpoints": [
        "https://github.com/Dinispg10/FlorDeLotus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
